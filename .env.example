# Server Port (Default is 8000 for local dev, overridden dynamically by Cloud Run via $PORT)
PORT=8000

# Operating Timezone for temporal validation and date checks
TZ=Africa/Khartoum

# Optional Service-to-Service Secret Token (Leave empty for Google IAM token validation)
OCR_SERVICE_SECRET=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
